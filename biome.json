{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"trailingNewline": true,
		"bracketSpacing": true,
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf",
		"delimiterSpacing": true,
		"bracketSameLine": false,
		"attributePosition": "multiline",
		"formatWithErrors": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "error",
			"complexity": "warn",
			"correctness": "error",
			"nursery": {
				"useConsistentFunctionStyle": "off"
			},
			"performance": "warn",
			"security": "error",
			"style": {
				"noJsxLiterals": "off",
				"noNonNullAssertion": "off"
			},
			"suspicious": "warn"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded",
			"attributePosition": "multiline",
			"delimiterSpacing": true,
			"bracketSpacing": true,
			"semicolons": "asNeeded",
			"trailingCommas": "none",
			"trailingNewline": true,
			"quoteProperties": "asNeeded",
			"jsxQuoteStyle": "single",
			"indentWidth": 2,
			"indentStyle": "tab"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
